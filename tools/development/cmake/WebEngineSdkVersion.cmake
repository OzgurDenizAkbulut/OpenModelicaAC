string(TOLOWER "qt${_om_webengine_module}version.h" _om_webengine_header)
set(_om_webengine_header "${OM_DEVELOPMENT_QT_ROOT}/include/qt6/Qt${_om_webengine_module}/${_om_webengine_header}")
set(PACKAGE_VERSION "0.0.0")
if(EXISTS "${_om_webengine_header}")
  file(STRINGS "${_om_webengine_header}" _om_webengine_version_line REGEX "VERSION_STR")
  string(REGEX MATCH "[0-9]+\\.[0-9]+\\.[0-9]+" PACKAGE_VERSION "${_om_webengine_version_line}")
endif()
set(PACKAGE_VERSION_COMPATIBLE FALSE)
set(PACKAGE_VERSION_EXACT FALSE)
if(PACKAGE_FIND_VERSION VERSION_EQUAL PACKAGE_VERSION)
  set(PACKAGE_VERSION_EXACT TRUE)
endif()
if(NOT PACKAGE_FIND_VERSION OR PACKAGE_VERSION_EXACT)
  set(PACKAGE_VERSION_COMPATIBLE TRUE)
elseif(PACKAGE_VERSION VERSION_GREATER PACKAGE_FIND_VERSION)
  string(REGEX MATCH "^[0-9]+\\.[0-9]+" _om_webengine_minor "${PACKAGE_VERSION}")
  if(_om_webengine_minor STREQUAL "${PACKAGE_FIND_VERSION_MAJOR}.${PACKAGE_FIND_VERSION_MINOR}")
    set(PACKAGE_VERSION_COMPATIBLE TRUE)
  endif()
endif()
