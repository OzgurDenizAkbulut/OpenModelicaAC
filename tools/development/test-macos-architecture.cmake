# Run with cmake -P tools/development/test-macos-architecture.cmake.
macro(omc_add_to_report)
endmacro()
set(APPLE TRUE)
set(CMAKE_OSX_ARCHITECTURES arm64)
include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/omc_target_info.cmake")
if(NOT OMC_TARGET_ARCH STREQUAL "arm64")
  message(FATAL_ERROR "Expected arm64, got ${OMC_TARGET_ARCH}")
endif()
set(CMAKE_OSX_ARCHITECTURES x86_64)
target_architecture(actual)
if(NOT actual STREQUAL "x86_64")
  message(FATAL_ERROR "Intel architecture changed: ${actual}")
endif()
set(CMAKE_OSX_ARCHITECTURES "arm64;x86_64")
target_architecture(actual)
if(NOT actual STREQUAL "x86_64;arm64")
  message(FATAL_ERROR "Universal architecture normalization failed: ${actual}")
endif()
message(STATUS "Apple Silicon, Intel and universal architecture checks passed")
